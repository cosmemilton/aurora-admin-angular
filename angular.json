{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "aurora-admin-angular": {
      "projectType": "application", "root": "", "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts", "index": "src/index.html", "tsConfig": "tsconfig.app.json",
            "outputPath": "dist/aurora-admin-angular",
            "assets": [{ "glob": "**/*", "input": "public" }],
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": { "outputHashing": "all" },
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "aurora-admin-angular:build:production" },
            "development": { "buildTarget": "aurora-admin-angular:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
